{
	"version": 3,
	"configurePresets": [
		{
			"name": "windows",
			"displayName": "Windows (vcpkg)",
			"binaryDir": "${sourceDir}/build/windows",
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"architecture": { "value": "x64", "strategy": "external" },
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		},
		{
			"name": "linux",
			"displayName": "Linux (system packages)",
			"binaryDir": "${sourceDir}/build/linux",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		}
	],
	"buildPresets": [
		{ "name": "windows-release", "configurePreset": "windows", "configuration": "Release" },
		{ "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" },
		{ "name": "windows-relwithdebinfo", "configurePreset": "windows", "configuration": "RelWithDebInfo" },
		{ "name": "linux", "configurePreset": "linux" }
	]
}
